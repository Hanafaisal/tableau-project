      <column caption='Avg Delivery Days per Order' datatype='real' name='[Calculation_0772735326527488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    { FIXED [order_id] : MIN([Calculation_1111110011944960]) }&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id])' />
